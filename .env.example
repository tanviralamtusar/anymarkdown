# Required: password protecting the web UI. Leave empty to disable auth entirely (not recommended on a public VPS).
APP_PASSWORD=change-me

# Required in production: signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to false only if serving over plain HTTP (e.g. local testing without a reverse proxy).
COOKIE_SECURE=true

# Max upload size per file, in megabytes.
MAX_UPLOAD_MB=50

# Optional: enables LLM-generated captions for images (uses OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: routes PDFs/images through Azure Document Intelligence instead of local parsing.
AZURE_DOC_INTEL_ENDPOINT=
